# Free-provider chain (§20A), used automatically in AUTO mode (the
# default) for normal conversation, tutoring, study, and reasoning, in this
# order: Groq -> Gemini -> OpenRouter free -> local (Ollama). None of these
# can incur a charge on their own; see brain/router.py and each provider's
# module docstring for how that's enforced/verified.

# 1st: Groq free tier (console.groq.com) — no credit card, rate-limit
# gated, no per-token charge on the free plan.
GROQ_API_KEY=
CIPHLET_GROQ_MODEL=llama-3.3-70b-versatile

# 2nd: Google Gemini free tier (aistudio.google.com/apikey) — no charge
# unless a billing account is explicitly linked; free-tier prompts may be
# used by Google to improve their products (see brain/gemini_provider.py).
GEMINI_API_KEY=
CIPHLET_GEMINI_MODEL=gemini-2.5-flash

# 3rd: OpenRouter free models (openrouter.ai/keys). Must be a model id
# ending in ':free' — brain/openrouter_provider.py refuses to call anything
# else, even if misconfigured. Pick a current one from
# https://openrouter.ai/models?max_price=0 — OpenRouter's free lineup
# rotates, so no default is shipped here.
OPENROUTER_API_KEY=
CIPHLET_OPENROUTER_MODEL=

# Optional PREMIUM Cloud Intelligence — Anthropic Claude. Completely
# outside the free chain above. Only used when a session is explicitly
# started with `ciphlet chat --premium` / `ciphlet voice --premium`; never
# called automatically, never incurs cost on its own.
ANTHROPIC_API_KEY=
CIPHLET_PREMIUM_BRAIN_MODEL=claude-sonnet-4-5

# 4th/final: Local Intelligence — a persistent Ollama server (§20A), not a
# per-request subprocess. Used as the last fallback when every free cloud
# provider above is unavailable, and used directly (no network AI call)
# when a session runs with `--local-only`. Requires `ollama serve` running
# on the Pi and the model pulled (`ollama pull gemma3:1b-it-q4_K_M` or
# your chosen model) — see deploy/install_pi.sh. Defaults shown work out
# of the box once Ollama itself is installed; only override if you're
# pointing at a different host or model.
#
# gemma3:1b-it-q4_K_M replaced an unsuccessful qwen2.5:3b-instruct-q4_K_M
# default: real Pi measurements on TWO different models both showed full
# prompt re-evaluation every turn (~1150-1200 tokens, no speedup from
# caching) — a verified Ollama CPU-backend bug for the /api/chat endpoint
# (ollama/ollama#14780), now fixed in code by using /api/generate +
# context instead (see brain/ollama_provider.py). Moving to a smaller 1B
# model on top of that cache fix directly targets conversational speed for
# the voice-first baseline. If you still have gemma2:2b/qwen2.5:3b
# installed from before, they are left untouched — remove them yourself
# once gemma3:1b is confirmed working:
#   ollama rm gemma2:2b-instruct-q4_0
#   ollama rm qwen2.5:3b-instruct-q4_K_M
CIPHLET_OLLAMA_HOST=http://localhost:11434
CIPHLET_OLLAMA_MODEL=gemma3:1b-it-q4_K_M
CIPHLET_OLLAMA_TIMEOUT_S=60
# Explicit context/output bounds. num_ctx bounds total prompt+reply
# tokens; num_predict caps how long a single reply can run.
CIPHLET_OLLAMA_NUM_CTX=2048
CIPHLET_OLLAMA_NUM_PREDICT=256
# Tight local raw-history window (message count) for the *first* local
# turn of a session — SQLite keeps the full conversation regardless;
# later turns in the same process reuse a cached KV context instead of
# resending raw history at all. Raise this if early recall feels too
# short; each unit is one stored message (user or assistant), not a pair.
CIPHLET_OLLAMA_HISTORY_MESSAGES=6
# To try a stronger-reasoning candidate instead:
#   ollama pull qwen3:4b-instruct-q4_K_M
#   then set: CIPHLET_OLLAMA_MODEL=qwen3:4b-instruct-q4_K_M
# This does not remove/replace whatever is currently installed — you can
# switch back by changing this line again.

# Memory (§5)
CIPHLET_DB_PATH=

# Voice (§20B) — optional; required only for `ciphlet voice`
CIPHLET_PIPER_MODEL=
CIPHLET_WAKE_MODEL=
CIPHLET_VOSK_MODEL_PATH=
